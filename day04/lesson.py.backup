def section1():
    """第一部分：类的基本概念"""
    print("\n" + "="*60)
    print("第一部分：类的基本概念")
    print("="*60)
    # 定义类 (class关键字)
    class Dog:
        """狗狗类"""
        # 类属性 (所有实例共享)
        species = "Canis familiaris"
        # 构造方法：创建实例时自动调用
        def __init__(self, name, age):
            """
            __init__是构造方法
            self代表实例本身，必须作为第一个参数
            """
            # 实例属性 (每个实例独立)
            self.name = name
            self.age = age
        # 实例方法
        def bark(self):
            """叫"""
            return f"{self.name} says: Woof!"
        def get_info(self):
            """获取信息"""
            return f"{self.name} is {self.age} years old"
    # 创建实例 (对象)
    print("创建对象:")
    dog1 = Dog("Buddy", 3)
    dog2 = Dog("Max", 5)
    # 访问属性和方法
    print(f"Dog1: {dog1.get_info()}")
    print(f"Dog2: {dog2.get_info()}")
    print(dog1.bark())
    # 访问类属性
    print(f"\n物种: {Dog.species}")
    print(f"Dog1物种: {dog1.species}")


def section2():
    """第二部分：self详解"""
    print("\n" + "="*60)
    print("第二部分：self详解")
    print("="*60)
    print("\n" + "="*60)
    print("self详解")
    print("="*60)
    class TestCase:
        """测试用例类"""
        def __init__(self, name, priority="medium"):
            self.name = name
            self.priority = priority
            self.status = "pending"  # 初始状态
        def run(self):
            """执行测试"""
            # self.name 访问当前实例的name属性
            print(f"执行测试: {self.name}")
            self.status = "running"
        def mark_passed(self):
            """标记通过"""
            self.status = "passed"
            print(f"{self.name}: 通过")
        def mark_failed(self, reason):
            """标记失败"""
            self.status = "failed"
            self.failure_reason = reason
            print(f"{self.name}: 失败 - {reason}")
    # 创建测试用例
    tc1 = TestCase("登录测试", "high")
    tc2 = TestCase("注册测试")
    print("\n测试用例操作:")
    tc1.run()
    tc1.mark_passed()
    tc2.run()
    tc2.mark_failed("元素未找到")
    print(f"\nTC1状态: {tc1.status}")
    print(f"TC2状态: {tc2.status}, 原因: {tc2.failure_reason}")


def section3():
    """第三部分：类方法和静态方法"""
    print("\n" + "="*60)
    print("第三部分：类方法和静态方法")
    print("="*60)
    print("\n" + "="*60)
    print("类方法和静态方法")
    print("="*60)
    class TestUtils:
        """测试工具类"""
        test_count = 0  # 类属性，统计测试数量
        def __init__(self):
            TestUtils.test_count += 1
            self.instance_id = TestUtils.test_count
        # 实例方法 - 操作实例
        def get_id(self):
            return self.instance_id
        # 类方法 - 操作类本身，用@classmethod装饰器
        @classmethod
        def get_count(cls):
            """cls代表类本身"""
            return cls.test_count
        @classmethod
        def reset_count(cls):
            cls.test_count = 0
            print("计数器已重置")
        # 静态方法 - 不依赖实例或类，用@staticmethod装饰器
        @staticmethod
        def generate_timestamp():
            """生成时间戳，与类无关的工具方法"""
            import time
            return int(time.time())
        @staticmethod
        def is_valid_email(email):
            """验证邮箱格式"""
            return "@" in email and "." in email
    # 使用类方法
    print("\n类方法:")
    print(f"当前测试数: {TestUtils.get_count()}")
    u1 = TestUtils()
    u2 = TestUtils()
    print(f"创建实例后: {TestUtils.get_count()}")
    TestUtils.reset_count()
    print(f"重置后: {TestUtils.get_count()}")
    # 使用静态方法
    print("\n静态方法:")
    print(f"时间戳: {TestUtils.generate_timestamp()}")
    print(f"邮箱验证: {TestUtils.is_valid_email('test@example.com')}")
    print(f"邮箱验证: {TestUtils.is_valid_email('invalid')}")


def section4():
    """第四部分：继承（重点！）"""
    print("\n" + "="*60)
    print("第四部分：继承（重点！）")
    print("="*60)
    print("\n" + "="*60)
    print("继承")
    print("="*60)
    # 基类 (父类)
    class BasePage:
        """页面基类 - 封装通用方法"""
        def __init__(self, driver):
            self.driver = driver
            self.url = None
        def open(self, url=None):
            """打开页面"""
            target_url = url or self.url
            print(f"打开页面: {target_url}")
            # self.driver.get(target_url)  # 实际代码
        def find_element(self, locator):
            """查找元素"""
            print(f"查找元素: {locator}")
            return f"Element({locator})"
        def click(self, locator):
            """点击元素"""
            print(f"点击: {locator}")
        def send_keys(self, locator, text):
            """输入文本"""
            print(f"在{locator}输入: {text}")
    # 子类 - 继承BasePage
    class LoginPage(BasePage):
        """登录页面 - 继承BasePage"""
        def __init__(self, driver):
            # 调用父类的构造方法
            super().__init__(driver)
            self.url = "/login"
            # 页面元素定位器
            self.username_input = ("id", "username")
            self.password_input = ("id", "password")
            self.login_button = ("id", "login-btn")
        def login(self, username, password):
            """登录操作"""
            self.open()
            self.send_keys(self.username_input, username)
            self.send_keys(self.password_input, password)
            self.click(self.login_button)
            print(f"登录: {username}")
    # 另一个子类
    class HomePage(BasePage):
        """首页"""
        def __init__(self, driver):
            super().__init__(driver)
            self.url = "/home"
        def get_welcome_text(self):
            """获取欢迎文本"""
            return self.find_element(("class", "welcome"))
        def logout(self):
            """退出登录"""
            self.click(("id", "logout"))
    # 使用继承
    print("\n继承示例:")
    mock_driver = "MockWebDriver"
    login_page = LoginPage(mock_driver)
    login_page.login("admin", "123456")
    home_page = HomePage(mock_driver)
    home_page.open()
    home_page.logout()
    # 方法重写 (Override)
    class MobileLoginPage(LoginPage):
        """移动端登录页 - 继承LoginPage"""
        def login(self, username, password):
            """重写登录方法，添加移动端特有逻辑"""
            print("[移动端] 检查软键盘...")
            super().login(username, password)  # 调用父类方法
            print("[移动端] 等待页面跳转...")
    print("\n方法重写:")
    mobile_login = MobileLoginPage(mock_driver)
    mobile_login.login("user", "pass")


def section5():
    """第五部分：多态"""
    print("\n" + "="*60)
    print("第五部分：多态")
    print("="*60)
    print("\n" + "="*60)
    print("多态")
    print("="*60)
    class ChromeDriver:
        def get(self, url):
            print(f"Chrome打开: {url}")
    class FirefoxDriver:
        def get(self, url):
            print(f"Firefox打开: {url}")
    def run_test(driver, url):
        """多态：不同的driver，相同的接口"""
        driver.get(url)
    print("\n多态示例:")
    chrome = ChromeDriver()
    firefox = FirefoxDriver()
    run_test(chrome, "http://example.com")
    run_test(firefox, "http://example.com")


