def section2():
    """第二部分：配置管理"""
    print("\n" + "="*60)
    print("第二部分：配置管理")
    print("="*60)
    class ConfigReader:
        """
        配置读取器
        支持YAML和JSON格式
        """
        def __init__(self, config_dir="config"):
            self.config_dir = Path(config_dir)
            self._configs = {}
        def load(self, filename):
            """
            加载配置文件
            参数:
                filename: 配置文件名
            返回:
                配置字典
            """
            if filename in self._configs:
                return self._configs[filename]
            file_path = self.config_dir / filename
            if not file_path.exists():
                raise FileNotFoundError(f"配置文件不存在: {file_path}")
            with open(file_path, "r", encoding="utf-8") as f:
                if filename.endswith(".yaml") or filename.endswith(".yml"):
                    config = yaml.safe_load(f)
                elif filename.endswith(".json"):
                    config = json.load(f)
                else:
                    raise ValueError(f"不支持的配置文件格式: {filename}")
            self._configs[filename] = config
            return config
        def get(self, filename, key=None, default=None):
            """
            获取配置值
            参数:
                filename: 配置文件名
                key: 配置键，支持点号分隔 (如 "database.host")
                default: 默认值
            """
            config = self.load(filename)
            if key is None:
                return config
            # 支持嵌套键 (如 "database.host")
            keys = key.split(".")
            value = config
            for k in keys:
                if isinstance(value, dict) and k in value:
                    value = value[k]
                else:
                    return default
            return value
        def reload(self, filename=None):
            """重新加载配置"""
            if filename:
                self._configs.pop(filename, None)
            else:
                self._configs.clear()
    # 配置示例
    CONFIG_EXAMPLE = """
    # config/config.yaml
    environment: test
    appium:
      server_url: "http://localhost:4723/wd/hub"
      implicit_wait: 10
      explicit_wait: 20
    database:
      host: localhost
      port: 3306
      name: test_db
      user: test_user
      password: test_pass
    report:
      screenshot_on_failure: true
      html_report: true
      allure_report: true
    log:
      level: INFO
      format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
      file: logs/test.log
    """
    print("\n配置示例:")
    print(CONFIG_EXAMPLE)


def section3():
    """第三部分：日志封装"""
    print("\n" + "="*60)
    print("第三部分：日志封装")
    print("="*60)
    class Logger:
        """
        日志工具类
        封装Python logging模块
        """
        _loggers = {}
        @classmethod
        def get_logger(cls, name="test", log_dir="logs", level=logging.INFO):
            """
            获取日志记录器
            参数:
                name: 日志名称
                log_dir: 日志目录
                level: 日志级别
            """
            if name in cls._loggers:
                return cls._loggers[name]
            # 创建logger
            logger = logging.getLogger(name)
            logger.setLevel(level)
            # 避免重复添加handler
            if logger.handlers:
                return logger
            # 创建日志目录
            log_path = Path(log_dir)
            log_path.mkdir(parents=True, exist_ok=True)
            # 日志格式
            formatter = logging.Formatter(
                "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
                datefmt="%Y-%m-%d %H:%M:%S"
            )
            # 控制台handler
            console_handler = logging.StreamHandler()
            console_handler.setLevel(level)
            console_handler.setFormatter(formatter)
            logger.addHandler(console_handler)
            # 文件handler
            log_file = log_path / f"{name}_{datetime.now().strftime('%Y%m%d')}.log"
            file_handler = logging.FileHandler(log_file, encoding="utf-8")
            file_handler.setLevel(level)
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
            cls._loggers[name] = logger
            return logger
        @classmethod
        def debug(cls, message, name="test"):
            """记录debug日志"""
            cls.get_logger(name).debug(message)
        @classmethod
        def info(cls, message, name="test"):
            """记录info日志"""
            cls.get_logger(name).info(message)
        @classmethod
        def warning(cls, message, name="test"):
            """记录warning日志"""
            cls.get_logger(name).warning(message)
        @classmethod
        def error(cls, message, name="test"):
            """记录error日志"""
            cls.get_logger(name).error(message)
        @classmethod
        def critical(cls, message, name="test"):
            """记录critical日志"""
            cls.get_logger(name).critical(message)
    # 日志装饰器
    def log_step(step_name):
        """
        步骤日志装饰器
        使用示例:
            @log_step("输入用户名")
            def input_username(self, username):
                self.send_keys(self.USERNAME_INPUT, username)
        """
        def decorator(func):
            def wrapper(*args, **kwargs):
                logger = Logger.get_logger()
                logger.info(f"[步骤] {step_name}")
                try:
                    result = func(*args, **kwargs)
                    logger.info(f"[步骤] {step_name} - 成功")
                    return result
                except Exception as e:
                    logger.error(f"[步骤] {step_name} - 失败: {e}")
                    raise
            return wrapper
        return decorator
    def log_test(test_func):
        """
        测试用例日志装饰器
        """
        def wrapper(*args, **kwargs):
            logger = Logger.get_logger()
            test_name = test_func.__name__
            logger.info(f"{'='*60}")
            logger.info(f"[测试开始] {test_name}")
            logger.info(f"{'='*60}")
            try:
                result = test_func(*args, **kwargs)
                logger.info(f"[测试通过] {test_name}")
                return result
            except Exception as e:
                logger.error(f"[测试失败] {test_name}: {e}")
                raise
            finally:
                logger.info(f"{'='*60}\n")
        return wrapper


def section4():
    """第四部分：Driver工厂"""
    print("\n" + "="*60)
    print("第四部分：Driver工厂")
    print("="*60)
    class DriverFactory:
        """
        WebDriver工厂类
        负责创建和管理Driver实例
        """
        _driver = None
        _config_reader = ConfigReader()
        @classmethod
        def get_driver(cls, platform=None, config_file="android_caps.yaml"):
            """
            获取Driver实例 (单例模式)
            参数:
                platform: 平台 (android/ios)
                config_file: 配置文件名
            """
            if cls._driver is None:
                cls._driver = cls.create_driver(platform, config_file)
            return cls._driver
        @classmethod
        def create_driver(cls, platform=None, config_file="android_caps.yaml"):
            """
            创建新的Driver实例
            参数:
                platform: 平台 (android/ios)
                config_file: 配置文件名
            """
            # 读取配置
            caps = cls._config_reader.load(config_file)
            # 获取server URL
            server_url = cls._config_reader.get("config.yaml", "appium.server_url", 
                                                "http://localhost:4723/wd/hub")
            logger = Logger.get_logger()
            logger.info(f"创建Driver: platform={platform}, caps={caps}")
            # 实际项目中使用:
            # from appium import webdriver
            # driver = webdriver.Remote(server_url, caps)
            # 模拟driver
            driver = MockDriver(caps)
            # 设置隐式等待
            implicit_wait = cls._config_reader.get("config.yaml", "appium.implicit_wait", 10)
            driver.implicitly_wait(implicit_wait)
            logger.info("Driver创建成功")
            return driver
        @classmethod
        def quit_driver(cls):
            """退出Driver"""
            if cls._driver:
                logger = Logger.get_logger()
                logger.info("退出Driver")
                cls._driver.quit()
                cls._driver = None
        @classmethod
        def restart_driver(cls, platform=None, config_file="android_caps.yaml"):
            """重启Driver"""
            cls.quit_driver()
            return cls.get_driver(platform, config_file)
    # 模拟Driver
    class MockDriver:
        def __init__(self, caps):
            self.caps = caps
            self.implicit_wait_time = 0
        def implicitly_wait(self, seconds):
            self.implicit_wait_time = seconds
        def quit(self):
            pass


def section5():
    """第五部分：基础页面对象 (带日志)"""
    print("\n" + "="*60)
    print("第五部分：基础页面对象 (带日志)")
    print("="*60)
    class BasePage:
        """
        基础页面类 (带日志)
        """
        def __init__(self, driver):
            self.driver = driver
            self.logger = Logger.get_logger("page")
        @log_step("查找元素")
        def find_element(self, locator):
            """查找元素"""
            by, value = locator
            self.logger.debug(f"查找元素: {by}={value}")
            # 实际: return self.driver.find_element(by, value)
            return MockElement(by, value)
        @log_step("点击元素")
        def click(self, locator):
            """点击元素"""
            element = self.find_element(locator)
            element.click()
        @log_step("输入文本")
        def send_keys(self, locator, text):
            """输入文本"""
            element = self.find_element(locator)
            element.clear()
            element.send_keys(text)
        def take_screenshot(self, filename=None):
            """截图"""
            if filename is None:
                filename = f"screenshot_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
            screenshot_dir = Path("screenshots")
            screenshot_dir.mkdir(exist_ok=True)
            filepath = screenshot_dir / filename
            self.logger.info(f"截图保存到: {filepath}")
            # 实际: self.driver.get_screenshot_as_file(str(filepath))
            return str(filepath)
    class MockElement:
        def __init__(self, by, value):
            self.by = by
            self.value = value
        def click(self):
            pass
        def clear(self):
            pass
        def send_keys(self, text):
            pass


