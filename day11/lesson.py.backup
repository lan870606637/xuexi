def section1():
    """第一部分：常用插件介绍"""
    print("\n" + "="*60)
    print("第一部分：常用插件介绍")
    print("="*60)
    """
    常用Pytest插件:
    1. pytest-html: 生成HTML报告
       pip install pytest-html
       pytest --html=report.html
    2. pytest-cov: 代码覆盖率
       pip install pytest-cov
       pytest --cov=src --cov-report=html
    3. pytest-xdist: 并行执行
       pip install pytest-xdist
       pytest -n auto  # 自动检测CPU核心数
    4. pytest-ordering: 控制测试顺序
       pip install pytest-ordering
       @pytest.mark.run(order=1)
    5. pytest-rerunfailures: 失败重试
       pip install pytest-rerunfailures
       pytest --reruns 3 --reruns-delay 1
    6. pytest-assume: 软断言
       pip install pytest-assume
       pytest.assume(x == 1)
    7. allure-pytest: 生成Allure报告
       pip install allure-pytest
       pytest --alluredir=./allure-results
    """


def section2():
    """第二部分：测试顺序控制"""
    print("\n" + "="*60)
    print("第二部分：测试顺序控制")
    print("="*60)
    # 使用pytest-ordering插件控制顺序
    # 安装: pip install pytest-ordering
    try:
        import pytest_ordering
        HAS_ORDERING = True
    except ImportError:
        HAS_ORDERING = False
        print("提示: 安装pytest-ordering可使用顺序控制: pip install pytest-ordering")
    if HAS_ORDERING:
        @pytest.mark.run(order=1)
        def test_first():
            """第一个执行"""
            print("\n  第一个测试")
        @pytest.mark.run(order=3)
        def test_last():
            """最后执行"""
            print("\n  最后一个测试")
        @pytest.mark.run(order=2)
        def test_middle():
            """中间执行"""
            print("\n  中间测试")
    # 使用依赖关系 (pytest-dependency)
    try:
        import pytest_dependency
        HAS_DEPENDENCY = True
    except ImportError:
        HAS_DEPENDENCY = False
    if HAS_DEPENDENCY:
        @pytest.mark.dependency()
        def test_login():
            """登录测试"""
            assert True
        @pytest.mark.dependency(depends=["test_login"])
        def test_access_resource():
            """访问资源 - 依赖登录"""
            assert True


def section3():
    """第三部分：软断言"""
    print("\n" + "="*60)
    print("第三部分：软断言")
    print("="*60)
    try:
        import pytest_assume
        HAS_ASSUME = True
    except ImportError:
        HAS_ASSUME = False
        print("提示: 安装pytest-assume可使用软断言: pip install pytest-assume")
    def test_hard_assert():
        """硬断言 - 失败立即停止"""
        assert 1 == 1
        # assert 1 == 2  # 如果取消注释，后面的代码不会执行
        assert 2 == 2
    if HAS_ASSUME:
        def test_soft_assert():
            """软断言 - 失败继续执行"""
            pytest.assume(1 == 1)
            pytest.assume(1 == 2, "这个会失败但继续执行")
            pytest.assume(2 == 2)
            # 最后汇总所有失败


def section4():
    """第四部分：失败重试"""
    print("\n" + "="*60)
    print("第四部分：失败重试")
    print("="*60)
    # 使用pytest-rerunfailures
    # 安装: pip install pytest-rerunfailures
    # 运行: pytest --reruns 3 --reruns-delay 1
    flaky_counter = 0
    @pytest.mark.flaky(reruns=3, reruns_delay=1)
    def test_flaky():
        """不稳定的测试 - 可能失败"""
        global flaky_counter
        flaky_counter += 1
        print(f"\n  第{flaky_counter}次尝试")
        # 前2次失败，第3次成功
        assert flaky_counter >= 3


def section5():
    """第五部分：测试钩子函数 (Hooks)"""
    print("\n" + "="*60)
    print("第五部分：测试钩子函数 (Hooks)")
    print("="*60)
    """
    钩子函数在conftest.py中定义，用于自定义测试行为
    这里列出常用钩子供参考
    """
    # 这些钩子需要在conftest.py中定义
    hooks_demo = '''
    # conftest.py
    import pytest
    def pytest_configure(config):
        """配置钩子：测试会话开始前调用"""
        print("\\n[Hook] 测试会话开始配置")
    def pytest_sessionstart(session):
        """会话开始钩子"""
        print("[Hook] 测试会话开始")
    def pytest_sessionfinish(session, exitstatus):
        """会话结束钩子"""
        print("[Hook] 测试会话结束")
    def pytest_collection_modifyitems(config, items):
        """修改收集到的测试项"""
        # 可以在这里修改测试顺序或添加标记
        print(f"[Hook] 收集到 {len(items)} 个测试")
    def pytest_runtest_setup(item):
        """每个测试前的setup钩子"""
        print(f"[Hook] 准备执行: {item.name}")
    def pytest_runtest_teardown(item, nextitem):
        """每个测试后的teardown钩子"""
        print(f"[Hook] 执行完毕: {item.name}")
    def pytest_runtest_makereport(item, call):
        """生成测试报告钩子"""
        if call.when == "call":
            if call.excinfo is not None:
                print(f"[Hook] 测试失败: {item.name}")
            else:
                print(f"[Hook] 测试通过: {item.name}")
    '''
    # 保存到文件供参考
    with open("hooks_demo.py", "w", encoding="utf-8") as f:
        f.write(hooks_demo)
    print("\n钩子函数示例已保存到 hooks_demo.py")


def section6():
    """第六部分：自定义插件"""
    print("\n" + "="*60)
    print("第六部分：自定义插件")
    print("="*60)
    """
    创建自定义pytest插件:
    1. 创建conftest.py或独立包
    2. 定义fixture和钩子
    3. 注册到pytest
    """
    custom_plugin = '''
    # myplugin.py - 自定义插件示例
    import pytest
    class TestDataPlugin:
        """测试数据插件"""
        def __init__(self, config):
            self.config = config
            self.test_data = {}
        def pytest_configure(self, config):
            """配置时加载测试数据"""
            self.test_data = {
                "users": ["admin", "user", "guest"],
                "environments": ["dev", "test", "prod"]
            }
        def pytest_generate_tests(self, metafunc):
            """动态生成测试"""
            if "test_user" in metafunc.fixturenames:
                metafunc.parametrize("test_user", self.test_data.get("users", []))
    # 注册插件
    def pytest_configure(config):
        config.pluginmanager.register(TestDataPlugin(config), "test_data_plugin")
    '''
    with open("custom_plugin_demo.py", "w", encoding="utf-8") as f:
        f.write(custom_plugin)
    print("自定义插件示例已保存到 custom_plugin_demo.py")


def section7():
    """第七部分：测试报告"""
    print("\n" + "="*60)
    print("第七部分：测试报告")
    print("="*60)
    """
    生成测试报告的方式:
    1. 终端报告 (默认)
       pytest -v
    2. HTML报告
       pip install pytest-html
       pytest --html=report.html --self-contained-html
    3. JUnit XML报告
       pytest --junitxml=report.xml
    4. Allure报告 (推荐)
       pip install allure-pytest
       pytest --alluredir=./allure-results
       allure serve ./allure-results
    5. 覆盖率报告
       pip install pytest-cov
       pytest --cov=src --cov-report=html
    """
    # Allure标记示例
    try:
        import allure
        HAS_ALLURE = True
    except ImportError:
        HAS_ALLURE = False
        print("提示: 安装allure-pytest可生成精美报告: pip install allure-pytest")
    if HAS_ALLURE:
        @allure.feature("用户管理")
        @allure.story("用户登录")
        @allure.severity(allure.severity_level.CRITICAL)
        def test_allure_login():
            """Allure报告示例"""
            with allure.step("输入用户名"):
                username = "admin"
                allure.attach(username, "用户名")
            with allure.step("输入密码"):
                password = "123456"
                allure.attach(password, "密码")
            with allure.step("点击登录"):
                result = "登录成功"
                allure.attach(result, "结果")
            assert result == "登录成功"


def section8():
    """第八部分：命令行选项"""
    print("\n" + "="*60)
    print("第八部分：命令行选项")
    print("="*60)
    def pytest_addoption(parser):
        """添加自定义命令行选项"""
        parser.addoption(
            "--env",
            action="store",
            default="test",
            help="测试环境: dev/test/prod"
        )
        parser.addoption(
            "--browser",
            action="store",
            default="chrome",
            help="浏览器: chrome/firefox/safari"
        )
    # 在conftest.py中定义后，可以这样使用:
    # pytest --env=prod --browser=firefox
    # 在测试中获取选项
    @pytest.fixture
    def env(request):
        """获取环境配置"""
        return request.config.getoption("--env")
    @pytest.fixture
    def browser(request):
        """获取浏览器配置"""
        return request.config.getoption("--browser")


def section9():
    """实战任务：创建测试套件"""
    print("\n" + "="*60)
    print("实战任务：创建测试套件")
    print("="*60)
    """
    任务：为下面的ECommerce类创建完整的测试套件，包括:
    1. 使用参数化测试各种场景
    2. 添加适当的标记
    3. 使用fixture准备测试数据
    4. 考虑使用软断言
    """
    class ECommerce:
        """电商系统"""
        def __init__(self):
            self.products = {
                1: {"name": "iPhone", "price": 999, "stock": 10},
                2: {"name": "iPad", "price": 799, "stock": 5},
            }
            self.cart = {}
        def get_product(self, product_id):
            """获取商品信息"""
            return self.products.get(product_id)
        def add_to_cart(self, product_id, quantity):
            """添加商品到购物车"""
            product = self.get_product(product_id)
            if not product:
                return {"success": False, "error": "商品不存在"}
            if product["stock"] < quantity:
                return {"success": False, "error": "库存不足"}
            if quantity <= 0:
                return {"success": False, "error": "数量必须大于0"}
            if product_id in self.cart:
                self.cart[product_id] += quantity
            else:
                self.cart[product_id] = quantity
            return {"success": True, "message": "已添加到购物车"}
        def get_cart_total(self):
            """获取购物车总价"""
            total = 0
            for product_id, quantity in self.cart.items():
                product = self.get_product(product_id)
                if product:
                    total += product["price"] * quantity
            return total
        def checkout(self):
            """结算"""
            if not self.cart:
                return {"success": False, "error": "购物车为空"}
            # 扣减库存
            for product_id, quantity in self.cart.items():
                self.products[product_id]["stock"] -= quantity
            total = self.get_cart_total()
            self.cart.clear()
            return {"success": True, "total": total, "message": "结算成功"}
    # 请在这里编写测试套件


