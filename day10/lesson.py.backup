def section1():
    """第一部分：参数化测试基础"""
    print("\n" + "="*60)
    print("第一部分：参数化测试基础")
    print("="*60)
    """
    @pytest.mark.parametrize 可以让一个测试用例运行多组数据
    """
    # 基本用法
    @pytest.mark.parametrize("input,expected", [
        (1, 1),
        (2, 4),
        (3, 9),
        (4, 16),
    ])
    def test_square(input, expected):
        """测试平方"""
        assert input ** 2 == expected
    # 单个参数
    @pytest.mark.parametrize("name", ["Alice", "Bob", "Charlie"])
    def test_greeting(name):
        """测试问候"""
        greeting = f"Hello, {name}!"
        assert name in greeting
    # 多个参数
    @pytest.mark.parametrize("username,password,expected", [
        ("admin", "123456", True),
        ("admin", "wrong", False),
        ("user", "password", True),
        ("user", "", False),
        ("", "123456", False),
    ])
    def test_authentication(username, password, expected):
        """测试认证"""
        # 模拟认证逻辑
        valid_users = {"admin": "123456", "user": "password"}
        result = valid_users.get(username) == password and username != ""
        assert result == expected


def section2():
    """第二部分：参数化高级用法"""
    print("\n" + "="*60)
    print("第二部分：参数化高级用法")
    print("="*60)
    # 给参数化测试添加ID
    @pytest.mark.parametrize("a,b,result", [
        pytest.param(1, 1, 2, id="small_numbers"),
        pytest.param(100, 200, 300, id="large_numbers"),
        pytest.param(-1, 1, 0, id="negative_number"),
        pytest.param(0, 0, 0, id="zeros"),
    ])
    def test_add_with_ids(a, b, result):
        """带ID的参数化测试"""
        assert a + b == result
    # 条件跳过某些参数
    @pytest.mark.parametrize("platform,version", [
        ("Android", 10),
        ("Android", 11),
        pytest.param("iOS", 14, marks=pytest.mark.skip(reason="iOS暂不支持")),
        ("Android", 12),
    ])
    def test_platform_support(platform, version):
        """测试平台支持"""
        assert platform in ["Android", "iOS"]
        assert version >= 10
    # 标记某些参数为预期失败
    @pytest.mark.parametrize("browser,feature", [
        ("Chrome", "supported"),
        ("Firefox", "supported"),
        pytest.param("IE", "supported", 
                     marks=pytest.mark.xfail(reason="IE不支持此功能")),
    ])
    def test_browser_feature(browser, feature):
        """测试浏览器功能"""
        supported_browsers = ["Chrome", "Firefox"]
        if browser == "IE":
            assert browser not in supported_browsers  # 预期失败
        else:
            assert browser in supported_browsers


def section3():
    """第三部分：参数化与Fixture结合"""
    print("\n" + "="*60)
    print("第三部分：参数化与Fixture结合")
    print("="*60)
    @pytest.fixture
    def database():
        """数据库fixture"""
        return {"connected": True, "data": []}
    @pytest.mark.parametrize("record", [
        {"id": 1, "name": "Alice"},
        {"id": 2, "name": "Bob"},
        {"id": 3, "name": "Charlie"},
    ])
    def test_insert_record(database, record):
        """测试插入记录"""
        database["data"].append(record)
        assert record in database["data"]


def section4():
    """第四部分：间接参数化"""
    print("\n" + "="*60)
    print("第四部分：间接参数化")
    print("="*60)
    @pytest.fixture
    def user(request):
        """根据参数创建用户"""
        user_type = request.param
        users = {
            "admin": {"role": "admin", "permissions": ["all"]},
            "user": {"role": "user", "permissions": ["read"]},
            "guest": {"role": "guest", "permissions": []},
        }
        return users.get(user_type, {"role": "unknown", "permissions": []})
    @pytest.mark.parametrize("user,expected_permissions", [
        ("admin", ["all"]),
        ("user", ["read"]),
        ("guest", []),
    ], indirect=["user"])  # indirect表示user参数通过fixture解析
    def test_user_permissions(user, expected_permissions):
        """测试用户权限"""
        assert user["permissions"] == expected_permissions


def section5():
    """第五部分：自定义标记"""
    print("\n" + "="*60)
    print("第五部分：自定义标记")
    print("="*60)
    # 在pytest.ini中定义标记 (需要创建pytest.ini文件)
    pytest_ini_content = '''
    [pytest]
    markers =
        smoke: 冒烟测试
        regression: 回归测试
        slow: 慢速测试
        integration: 集成测试
        unit: 单元测试
        api: API测试
        ui: UI测试
        critical: 关键测试
        flaky: 不稳定测试
    '''
    # 创建pytest.ini
    with open("pytest.ini", "w", encoding="utf-8") as f:
        f.write(pytest_ini_content)
    print("已创建pytest.ini")
    # 使用自定义标记
    @pytest.mark.smoke
    @pytest.mark.critical
    def test_critical_login():
        """关键登录测试"""
        assert True
    @pytest.mark.regression
    @pytest.mark.slow
    def test_full_regression():
        """完整回归测试"""
        assert True
    @pytest.mark.integration
    @pytest.mark.api
    def test_api_integration():
        """API集成测试"""
        assert True
    @pytest.mark.flaky
    @pytest.mark.skip(reason="不稳定，暂时跳过")
    def test_flaky_feature():
        """不稳定的功能测试"""
        assert True


def section6():
    """第六部分：标记组合和过滤"""
    print("\n" + "="*60)
    print("第六部分：标记组合和过滤")
    print("="*60)
    """
    运行指定标记的测试:
    # 只运行smoke测试
    pytest -m smoke
    # 运行smoke和critical
    pytest -m "smoke and critical"
    # 运行smoke或regression
    pytest -m "smoke or regression"
    # 排除slow测试
    pytest -m "not slow"
    # 复杂组合
    pytest -m "(smoke or critical) and not slow"
    """


def section7():
    """第七部分：动态生成测试"""
    print("\n" + "="*60)
    print("第七部分：动态生成测试")
    print("="*60)
    def pytest_generate_tests(metafunc):
        """
        钩子函数：动态生成测试参数
        在conftest.py中定义，这里仅作演示
        """
        # 如果测试函数有dynamic_param参数
        if "dynamic_param" in metafunc.fixturenames:
            # 动态生成参数
            values = [1, 2, 3, 4, 5]
            metafunc.parametrize("dynamic_param", values)
    # 注意：这个测试需要在conftest.py中定义钩子才能运行
    def _test_dynamic(dynamic_param):
        """动态参数测试"""
        assert dynamic_param > 0


def section8():
    """实战任务：参数化测试实战"""
    print("\n" + "="*60)
    print("实战任务：参数化测试实战")
    print("="*60)
    """
    任务：为下面的Calculator类编写完整的参数化测试
    """
    class Calculator:
        """计算器类"""
        def add(self, a, b):
            return a + b
        def subtract(self, a, b):
            return a - b
        def multiply(self, a, b):
            return a * b
        def divide(self, a, b):
            if b == 0:
                raise ValueError("除数不能为零")
            return a / b
        def power(self, base, exponent):
            return base ** exponent
    # 请在这里编写参数化测试
    # 提示：
    # 1. 为每个方法编写参数化测试
    # 2. 考虑边界值：0、负数、大数
    # 3. 为divide测试异常情况
    # 4. 使用pytest.raises测试异常


