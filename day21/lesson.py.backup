def section1():
    """第一部分：Jenkins基础"""
    print("\n" + "="*60)
    print("第一部分：Jenkins基础")
    print("="*60)
    """
    Jenkins是什么？
    - 开源的持续集成/持续部署(CI/CD)工具
    - 自动化构建、测试、部署
    - 丰富的插件生态
    安装Jenkins:
    1. 下载: https://www.jenkins.io/download/
    2. 安装Java (Jenkins需要Java运行)
    3. 运行: java -jar jenkins.war
    4. 访问: http://localhost:8080
    5. 按提示完成初始化
    常用插件:
    - Git Plugin: Git集成
    - Allure Plugin: Allure报告
    - HTML Publisher: HTML报告
    - Email Extension: 邮件通知
    - Build Pipeline: 流水线视图
    """


def section2():
    """第二部分：Jenkins Pipeline"""
    print("\n" + "="*60)
    print("第二部分：Jenkins Pipeline")
    print("="*60)
    JENKINSFILE_EXAMPLE = '''
    // Jenkinsfile - 定义Pipeline
    pipeline {
        agent any  // 在任何可用节点运行
        environment {
            // 环境变量
            PYTHON_VERSION = '3.9'
            TEST_ENV = 'staging'
        }
        stages {
            stage('Checkout') {
                steps {
                    // 拉取代码
                    git branch: 'main', 
                        url: 'https://github.com/your-repo/test-automation.git'
                }
            }
            stage('Setup') {
                steps {
                    // 安装依赖
                    sh 'pip install -r requirements.txt'
                }
            }
            stage('Test') {
                steps {
                    // 运行测试
                    sh 'pytest tests/ -v --alluredir=allure-results'
                }
            }
            stage('Report') {
                steps {
                    // 生成Allure报告
                    allure([
                        includeProperties: false,
                        jdk: '',
                        properties: [],
                        reportBuildPolicy: 'ALWAYS',
                        results: [[path: 'allure-results']]
                    ])
                }
            }
        }
        post {
            always {
                // 总是执行
                echo '测试完成'
            }
            success {
                // 成功时执行
                echo '测试通过!'
            }
            failure {
                // 失败时执行
                echo '测试失败!'
                mail to: 'team@example.com',
                     subject: "测试失败: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
                     body: "请检查: ${env.BUILD_URL}"
            }
        }
    }
    '''
    print("Jenkinsfile示例:")
    print(JENKINSFILE_EXAMPLE)


def section3():
    """第三部分：Allure报告"""
    print("\n" + "="*60)
    print("第三部分：Allure报告")
    print("="*60)
    """
    Allure是一个灵活的测试报告工具
    安装:
    pip install allure-pytest
    生成报告:
    1. 运行测试生成结果:
       pytest --alluredir=./allure-results
    2. 生成并查看报告:
       allure serve ./allure-results
    3. 生成静态报告:
       allure generate ./allure-results -o ./allure-report --clean
    """
    ALLURE_DECORATORS = '''
    # Allure装饰器示例
    import allure
    import pytest
    @allure.feature("用户管理")  # 功能模块
    @allure.story("用户登录")    # 用户故事
    @allure.severity(allure.severity_level.CRITICAL)  # 严重程度
    class TestLogin:
        @allure.title("测试正常登录")  # 用例标题
        @allure.description("使用正确的用户名密码登录")  # 描述
        def test_login_success(self):
            with allure.step("输入用户名"):  # 测试步骤
                username = "admin"
                allure.attach(username, "用户名")  # 附加信息
            with allure.step("输入密码"):
                password = "123456"
                allure.attach(password, "密码")
            with allure.step("点击登录"):
                result = login(username, password)
                allure.attach(str(result), "登录结果")
            assert result["success"] is True
        @allure.title("测试登录失败")
        @pytest.mark.parametrize("username,password", [
            ("admin", "wrong"),
            ("", "123456"),
        ])
        def test_login_failure(self, username, password):
            allure.dynamic.title(f"测试登录失败: {username}/{password}")
            result = login(username, password)
            assert result["success"] is False
    '''
    print("\nAllure装饰器示例:")
    print(ALLURE_DECORATORS)


def section4():
    """第四部分：Git集成"""
    print("\n" + "="*60)
    print("第四部分：Git集成")
    print("="*60)
    GIT_WORKFLOW = """
    Git工作流:
    1. 初始化仓库
    git init
    2. 添加远程仓库
    git remote add origin https://github.com/your-repo.git
    3. 添加文件
    git add .
    4. 提交
    git commit -m "Initial commit"
    5. 推送
    git push -u origin main
    6. 创建分支
    git checkout -b feature/new-feature
    7. 合并分支
    git checkout main
    git merge feature/new-feature
    8. 标签
    git tag -a v1.0 -m "Version 1.0"
    git push origin v1.0
    .gitignore示例:
    # Python
    __pycache__/
    *.py[cod]
    *$py.class
    *.so
    .Python
    env/
    venv/
    .venv/
    # IDE
    .idea/
    .vscode/
    *.swp
    *.swo
    # 测试
    .pytest_cache/
    .coverage
    htmlcov/
    allure-results/
    allure-report/
    # 日志和报告
    logs/
    reports/
    screenshots/
    *.log
    # 配置
    config/local.yaml
    .env
    """
    print(GIT_WORKFLOW)


def section5():
    """第五部分：项目部署脚本"""
    print("\n" + "="*60)
    print("第五部分：项目部署脚本")
    print("="*60)
    SETUP_SCRIPT = '''#!/bin/bash
    # setup.sh - 项目部署脚本
    echo "=== 开始部署测试环境 ==="
    # 1. 检查Python版本
    python_version=$(python3 --version 2>&1 | awk '{print $2}')
    echo "Python版本: $python_version"
    # 2. 创建虚拟环境
    echo "创建虚拟环境..."
    python3 -m venv venv
    source venv/bin/activate
    # 3. 安装依赖
    echo "安装依赖..."
    pip install --upgrade pip
    pip install -r requirements.txt
    # 4. 检查Appium
    echo "检查Appium..."
    appium --version
    # 5. 创建目录
    echo "创建目录..."
    mkdir -p logs reports screenshots data
    # 6. 运行测试
    echo "运行测试..."
    pytest tests/ -v --html=reports/report.html --self-contained-html
    echo "=== 部署完成 ==="
    '''
    # 保存部署脚本
    with open("setup.sh", "w", encoding="utf-8") as f:
        f.write(SETUP_SCRIPT)
    # Windows版本
    SETUP_BAT = '''@echo off
    REM setup.bat - Windows部署脚本
    echo === 开始部署测试环境 ===
    REM 1. 检查Python
    python --version
    REM 2. 创建虚拟环境
    echo 创建虚拟环境...
    python -m venv venv
    venv\\Scripts\\activate
    REM 3. 安装依赖
    echo 安装依赖...
    pip install --upgrade pip
    pip install -r requirements.txt
    REM 4. 创建目录
    echo 创建目录...
    if not exist logs mkdir logs
    if not exist reports mkdir reports
    if not exist screenshots mkdir screenshots
    if not exist data mkdir data
    echo === 部署完成 ===
    pause
    '''
    with open("setup.bat", "w", encoding="utf-8") as f:
        f.write(SETUP_BAT)
    print("\n部署脚本已生成: setup.sh, setup.bat")


