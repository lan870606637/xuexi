def section7():
    """第七部分：pytest.ini配置"""
    print("\n" + "="*60)
    print("第七部分：pytest.ini配置")
    print("="*60)
    PYTEST_INI = """[pytest]
    # 测试目录
    testpaths = tests
    # 标记定义
    markers =
        smoke: 冒烟测试
        regression: 回归测试
        integration: 集成测试
        performance: 性能测试
        slow: 慢速测试
    # 默认参数
    addopts = 
        -v
        --tb=short
        --strict-markers
        --html=reports/report.html
        --self-contained-html
        --alluredir=allure-results
    # 过滤器
    filterwarnings =
        ignore::DeprecationWarning
        ignore::PendingDeprecationWarning
    # 日志
    log_cli = true
    log_cli_level = INFO
    log_cli_format = %(asctime)s [%(levelname)s] %(message)s
    log_cli_date_format = %Y-%m-%d %H:%M:%S
    """
    with open("pytest.ini", "w", encoding="utf-8") as f:
        f.write(PYTEST_INI)
    print("pytest.ini已生成")


