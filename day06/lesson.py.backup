def main():
    """主菜单"""
    while True:
        print("\n" + "="*60)
        print("Day {day_num}: 学习菜单")
        print("="*60)
        print("1. 第一部分：文件读写基础")
        print("2. 第二部分：文件路径操作")
        print("3. 第三部分：JSON处理")
        print("4. 第四部分：YAML处理")
        print("5. 第五部分：CSV处理 (测试数据常用)")
        print("6. 实战任务：读取测试配置")
        print("7. 参考答案（完成后对照）")
        print("8. 今日学习要点总结")
        print("9. 实战任务")
        print("8. 参考答案")
        print("7. 学习总结")
        print("0. 退出")
        print("="*60)
        
        choice = input("\n请选择 (0-9): ").strip()
        
        if choice == "1":
            section1()
        if choice == "2":
            section2()
        if choice == "3":
            section3()
        if choice == "4":
            section4()
        if choice == "5":
            section5()
        if choice == "6":
            section6()
        if choice == "7":
            section7()
        if choice == "8":
            section8()
        elif choice == "9":
            practice_task()
        elif choice == "8":
            show_answer()
        elif choice == "7":
            show_summary()
        elif choice == "0":
            print("\n感谢学习！再见！")
            break
        else:
            print("\n无效选择，请重新输入")
        
        input("\n按回车键继续...")


if __name__ == "__main__":
    main()
